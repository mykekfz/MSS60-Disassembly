/* ------------------------------------------------------------------
   MSS60 INJ A2L - Production calibration 7848136 (V762.01-B500.02)

   Created by ZiMMie for the M5Board and Nam3Forum communities.

   This project exists to make this information freely available
   to everyone: to share the work, encourage collaboration, and let
   others learn from it, use it and add their own knowledge.

   The reference material is based on publicly available beta
   program software. Ghidra was used to disassemble and analyse
   the current V762 program.

   This is a community effort, and every contribution matters.
   Corrections, additional findings, technical knowledge and general
   feedback are all very welcome. The more knowledge is shared and
   the more people work together, the more can be achieved.

   Completely free to use and share.
   ------------------------------------------------------------------ */

ASAP2_VERSION 1 60
/begin PROJECT MSS60_V762_INJ "MSS60 (S65) V762 INJ CPU - generated 04.11.2026 from the reverse-engineered XDF"
  /begin HEADER "Calibration description (characteristics from the XDF; measurements = V530 RAM names transferred to V762 addresses, confidence in each long identifier). Status tag in every long identifier: verified (checked against the code) / A2L-ref (placed from the V530 A2L) / EST (estimated) / unassigned (UNK placeholder)." VERSION "V762-RE-04112026" /end HEADER
  /begin MODULE INJ "MSS60 V762 INJ"
    /begin MOD_COMMON ""
      BYTE_ORDER MSB_FIRST
      ALIGNMENT_BYTE 1
      ALIGNMENT_WORD 2
      ALIGNMENT_LONG 4
    /end MOD_COMMON
    /begin MOD_PAR ""
      ECU "MSS60-INJ"
      SUPPLIER "Siemens VDO / BMW M"
      /begin MEMORY_SEGMENT DATASEG1 "Calibration data" DATA FLASH INTERN 0x70000 0x10000 -1 -1 -1 -1 -1 /end MEMORY_SEGMENT
      /begin MEMORY_SEGMENT CODESEG1 "Program" CODE FLASH INTERN 0x10000 0x60000 -1 -1 -1 -1 -1 /end MEMORY_SEGMENT
    /end MOD_PAR
    /begin AXIS_PTS GAX_0732C "Group axis (4 points) shared by group curves/maps" 0x7732C NO_INPUT_QUANTITY RL_AXP_SW 0 CM_0024 4 -3276.8 3276.7
      FORMAT "%.4g"
    /end AXIS_PTS
    /begin AXIS_PTS GAX_080B0 "Group axis (12 points) shared by group curves/maps" 0x780B0 NO_INPUT_QUANTITY RL_AXP_SW 0 CM_0028 12 -3276.8 3276.7
      FORMAT "%.4g"
    /end AXIS_PTS
    /begin AXIS_PTS GAX_094FC "Group axis (10 points) shared by group curves/maps" 0x794FC NO_INPUT_QUANTITY RL_AXP_SW 0 CM_0235 10 -32768 32767
      FORMAT "%.4g"
    /end AXIS_PTS
    /begin AXIS_PTS GAX_09512 "Group axis (4 points) shared by group curves/maps" 0x79512 NO_INPUT_QUANTITY RL_AXP_SW 0 CM_0003 4 -3.2768 3.2767
      FORMAT "%.4g"
    /end AXIS_PTS
    /begin AXIS_PTS GAX_0615E "Group axis (7 points) shared by group curves/maps" 0x7615E NO_INPUT_QUANTITY RL_AXP_SB 0 CM_0015 7 -128 127
      FORMAT "%.4g"
    /end AXIS_PTS
