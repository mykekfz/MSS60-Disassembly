      VALUE 0x7024B RL_VAL_UB 0 CM_0000 0 255
      FORMAT "%.4g"
      DISPLAY_IDENTIFIER K_DIAGNOSE_INDEX_HI__INJ_
    /end CHARACTERISTIC
