   MSS60 IGN A2L - Production calibration 7848136 (V762.01-B500.02)

   Created by ZiMMie for the M5Board and Nam3Forum communities.

   This project exists to make this information freely available
   to everyone: to share the work, encourage collaboration, and let
   others learn from it, use it and add their own knowledge.

   The reference material is based on publicly available beta
   program software. Ghidra was used to disassemble and analyse
   the current V762 program.

   This is a community effort, and every contribution matters.
   Corrections, additional findings, technical knowledge and general
   feedback are all very welcome. The more knowledge is shared and
   the more people work together, the more can be achieved.

   Completely free to use and share.
   ------------------------------------------------------------------ */

ASAP2_VERSION 1 60
/begin PROJECT MSS60_V762_IGN "MSS60 (S65) V762 IGN CPU - production calibration 7848136 (V762.01-B500.02)"
  /begin HEADER "Calibration description. Measurements: V530 RAM names transferred to V762 addresses (confidence in each long identifier). Status tag in every long identifier: verified (checked against the code) / A2L-ref (placed from the V530 A2L) / EST (estimated) / unassigned (unidentified)." VERSION "V762-RE-04112026" /end HEADER
  /begin MODULE IGN "MSS60 V762 IGN"
    /begin MOD_COMMON ""
      BYTE_ORDER MSB_FIRST
      ALIGNMENT_BYTE 1
      ALIGNMENT_WORD 2
      ALIGNMENT_LONG 4
    /end MOD_COMMON
    /begin MOD_PAR ""
      ECU "MSS60-IGN"
      SUPPLIER "Siemens VDO / BMW M"
      /begin MEMORY_SEGMENT DATASEG1 "Calibration data" DATA FLASH INTERN 0x70000 0x10000 -1 -1 -1 -1 -1 /end MEMORY_SEGMENT
      /begin MEMORY_SEGMENT CODESEG1 "Program" CODE FLASH INTERN 0x10000 0x60000 -1 -1 -1 -1 -1 /end MEMORY_SEGMENT
    /end MOD_PAR
    /begin AXIS_PTS GAX_136F0 "Group axis (16 points) shared by group curves/maps" 0x736F0 NO_INPUT_QUANTITY RL_AXP_SW 0 CM_0002 16 -32768 32767
      FORMAT "%.4g"
    /end AXIS_PTS
    /begin AXIS_PTS GAX_1372C "Group axis (10 points) shared by group curves/maps" 0x7372C NO_INPUT_QUANTITY RL_AXP_SW 0 CM_0003 10 -3.2768 3.2767
      FORMAT "%.4g"
    /end AXIS_PTS
    /begin AXIS_PTS GAX_139C0 "Group axis (5 points) shared by group curves/maps" 0x739C0 NO_INPUT_QUANTITY RL_AXP_UB 0 CM_0069 5 1 256
      FORMAT "%.4g"
    /end AXIS_PTS
    /begin AXIS_PTS GAX_136C0 "Group axis (10 points) shared by group curves/maps" 0x736C0 NO_INPUT_QUANTITY RL_AXP_SW 0 CM_0235 10 -32768 32767
      FORMAT "%.4g"
    /end AXIS_PTS
    /begin AXIS_PTS GAX_136D6 "Group axis (12 points) shared by group curves/maps" 0x736D6 NO_INPUT_QUANTITY RL_AXP_SW 0 CM_0235 12 -32768 32767
      FORMAT "%.4g"
    /end AXIS_PTS
